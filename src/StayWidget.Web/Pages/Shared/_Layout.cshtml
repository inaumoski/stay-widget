@inject SiteOrigin Site
@{var publicPage=PublicPages.IsPublic(Context.Request.Path);}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · StayWidget</title>
@if(publicPage){<meta name="description" content="@(ViewData["Description"]??"Simple direct reservation requests for small B&Bs, guesthouses and holiday rentals. Keep your existing website and confirm each stay yourself.")"/><link rel="canonical" href="@(Site.Value+Context.Request.Path)"/>}
<link rel="stylesheet" href="/site.css"/></head><body><header><a class="brand" href="/">StayWidget<span>Simple stays. Clear requests.</span></a><nav aria-label="Main">@if(publicPage){<a href="/Pricing">Pricing</a><a href="/Demo">Demo</a><a href="/Install">Installation</a>}<a href="/Owner">Owner dashboard</a>@if(User.Identity?.IsAuthenticated == true){<form method="post" action="/SignIn?handler=Logout"><button class="secondary">Sign out</button></form>}else{<a href="/SignIn">Sign in</a>}</nav></header><main>@RenderBody()</main><footer><p>Reservation requests need property approval. Guest confirmation email requires configured delivery. No external calendar synchronization.</p>
@if(publicPage){<nav aria-label="Product information"><a href="/Limitations">Limitations</a><a href="/Privacy">Privacy draft</a><a href="/Terms">Terms of use (draft)</a><a href="/Contact">Contact and support</a></nav><nav class="ecosystem" aria-label="More from this ecosystem"><h2>More from this ecosystem</h2><ul><li><a href="https://funtoolio.com/">Funtoolio</a> — small, useful tools</li><li><a href="https://approve.funtoolio.com/">Do Approve Me</a> — design feedback and approvals</li><li><a href="https://shopdesk.funtoolio.com/">Shopdesk</a> — checklists and shift planning</li><li><a href="https://wealthcalc.funtoolio.com/">WealthCalc</a> — savings and investing calculators</li></ul></nav>}
</footer>@await RenderSectionAsync("Scripts", required:false)</body></html>
