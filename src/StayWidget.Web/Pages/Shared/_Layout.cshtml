<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · StayWidget</title><link rel="stylesheet" href="/site.css"/></head><body><header><a class="brand" href="/">StayWidget<span>Simple stays. Clear requests.</span></a><nav aria-label="Main"><a href="/Owner">Owner dashboard</a>@if(User.Identity?.IsAuthenticated == true){<form method="post" action="/SignIn?handler=Logout"><button class="secondary">Sign out</button></form>}else{<a href="/SignIn">Sign in</a>}</nav></header><main>@RenderBody()</main><footer>Reservation requests need property approval. No automated email or calendar synchronization in this preview.</footer>@await RenderSectionAsync("Scripts", required:false)</body></html>
