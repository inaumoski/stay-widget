@model StayWidget.Web.CalendarView
<section class="availability-calendar" aria-label="Availability calendar" data-endpoint="@Model.Endpoint" data-unit="@Model.UnitId" data-min-nights="@Model.MinNights" data-month="@Model.InitialMonth">
<h2>Available nights</h2><p>Click check-in, then check-out to highlight your stay. Click again to start over. Check-out is excluded.</p>
<div class="calendar-controls"><button type="button" class="secondary" data-calendar-prev aria-label="Previous month">←</button><strong data-calendar-title></strong><button type="button" class="secondary" data-calendar-next aria-label="Next month">→</button></div>
<p data-calendar-status role="status">Loading availability… Date fields below work independently.</p><p data-calendar-selection></p><div data-calendar-grid></div><p class="calendar-legend">× Unavailable · In / Out Selected dates. Pending requests do not hold nights.</p><button type="button" class="secondary" data-calendar-retry hidden>Retry calendar</button><noscript><p>The calendar needs JavaScript; use the date fields and Check availability instead.</p></noscript>
</section>
