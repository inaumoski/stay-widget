@model StayWidget.Web.Pages.RequestModel
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · @Model.Property.Name</title><link rel="stylesheet" href="/site.css"/><link rel="stylesheet" href="/widget-theme/@(Model.Property.Id).css"/></head>
<body class="widget"><main>@RenderBody()</main><footer>@if(Model.ShowBranding){<span>Booking requests by <a href="/go/product" target="_blank" rel="sponsored noopener">StayWidget</a> · <a href="/go/portfolio" target="_blank" rel="sponsored noopener">Funtoolio</a></span>}<p>No external calendar synchronization. Outside bookings must be recorded manually.</p><p><partial name="Shared/_ReservationTermsLink"/></p></footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
