@page "/request/{id:guid}"
@model RequestModel
@{ViewData["Title"]="Request a stay";if(Model.IsWidget){Layout="Shared/_WidgetLayout";}}
@if(Model.IsWidget){<div id="embed-context" data-instance="@Model.InstanceId" data-origins="@System.Text.Json.JsonSerializer.Serialize(Model.ParentOrigins)"></div>}
<p class="eyebrow">A PERSONAL WELCOME</p><h1>@Model.Property.Name</h1><p>Choose an individual unit and request a stay. Outside bookings must be maintained manually by the property.</p><p>Submitting an enquiry does not reserve dates. The property agrees price and terms with you before confirming. @Model.EmailNotice</p>
<p>For accommodation prices, refer to the property's own website. StayWidget does not calculate a price quote. Agree the final total and terms with the property before confirmation.</p>
<div asp-validation-summary="All" class="error" role="alert"></div>
@if(Model.Receipt is not null){<section class="card"><h2>@(Model.ReceiptStatus?.State=="Accepted"?"Reservation confirmed":Model.ReceiptStatus?.State=="Pending"?"Request received — awaiting approval":Model.ReceiptStatus?.State??"Request received")</h2><p>Your request was saved. Open and save your private link to check the owner's decision or manage this enquiry. @Model.EmailNotice</p><a class="button" href="@Model.ReceiptLink" target="_blank" rel="noopener">Open private status and actions</a><p>Anyone holding this link can view the enquiry, withdraw it while pending or request cancellation after confirmation. A cancellation request does not release booked dates.</p><p>Property contact: @Model.Property.Contact</p></section>}
else{
<form method="post" action="@((Model.IsWidget?"/w/":"/request/")+Model.Property.Id+(Model.InstanceId!=null?"?InstanceId="+Model.InstanceId:""))" asp-antiforgery="false" class="card"><input asp-for="Key" type="hidden"/><input asp-for="FormContext" type="hidden"/>
<div class="bot-field" aria-hidden="true"><label asp-for="Website">Leave this field empty</label><input asp-for="Website" tabindex="-1" autocomplete="off"/></div>
<label asp-for="UnitId">Accommodation</label><select asp-for="UnitId">@foreach(var u in Model.Units){<option value="@u.Id" data-min-nights="@u.MinNights">@u.Name · up to @u.Capacity guests · @u.MinNights–@u.MaxNights nights</option>}</select>
@if(Model.Property.ShowAvailabilityCalendar){<partial name="Shared/_AvailabilityCalendar" model="@(new StayWidget.Web.CalendarView($"/api/widget/{Model.Property.Id}/calendar",Model.Unit.Id.ToString(),Model.Unit.MinNights,Model.CalendarMonth))"/>}
<div class="columns"><div><label asp-for="Arrival">Check-in</label><input asp-for="Arrival" type="date" required/></div><div><label asp-for="Departure">Check-out</label><input asp-for="Departure" type="date" required/></div><div><label asp-for="Guests">Guests</label><input asp-for="Guests" type="number" min="1" max="20" required/></div></div>
<button name="action" value="Search" formnovalidate class="secondary">Check availability</button>
@if(Model.Available.HasValue){<p role="status" aria-label="Stay availability result">@(Model.Available.Value?"These dates are available to request. They are not held.":"These dates are unavailable. Try other dates or contact the property.")</p>}
<h2>Your contact details</h2><label asp-for="GuestName">Name</label><input asp-for="GuestName" autocomplete="name" maxlength="120" required/><label asp-for="Phone">Phone, including country code</label><input asp-for="Phone" type="tel" autocomplete="tel" maxlength="40" required/>
<label asp-for="Email">Email for confirmation</label><input asp-for="Email" type="email" autocomplete="email" maxlength="254" required/><p>Check the spelling. Confirmation is sent only after owner approval when delivery is enabled. This address is not verified and is never used for marketing.</p>
<p>StayWidget is a tool provided by Funtoolio. Your accommodation agreement is with the property; Funtoolio is not a party or guarantor of either side's performance. Mandatory rights and Funtoolio's own service obligations remain. <a href="/Terms#reservation-agreements" target="_blank" rel="noopener">StayWidget service terms (draft)</a>.</p>
<h2>Property policies</h2><p class="policies">@Model.Property.Policies</p><p>Contact: @Model.Property.Contact</p><label class="check"><input asp-for="Agree" required/> I reviewed these policies and understand this is a request awaiting approval, without a date hold.</label><button name="action" value="Submit">Send reservation request</button></form>
<p>Safety limits apply: up to five new valid attempts per network in ten minutes and 100 new requests per property per UTC day. Accepted requests remain saved, and identical retries do not consume new-request limits. If you are blocked on a shared network, contact the property directly.</p>
}
@section Scripts{ @if(Model.Property.ShowAvailabilityCalendar){<script src="/availability-calendar.js" defer></script>} @if(Model.IsWidget){<script src="/embed/v1/child.js" defer></script>} }
